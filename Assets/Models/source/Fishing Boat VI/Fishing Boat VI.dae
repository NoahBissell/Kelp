    <library_effects>
        <effect id="MAT-fx" name="acmat_6_002">
            <profile_COMMON>
                <newparam sid="IMG-SURF">
                    <surface type="2D">
                        <init_from>IMG</init_from>
                    </surface>
                </newparam>
                <newparam sid="IMG-SAMP">
                    <sampler2D>
                        <source>IMG-SURF</source>
                    </sampler2D>
                </newparam>
                <technique sid="standard">
                    <phong>
                        <emission>
                            <color>0 0 0 1</color>
                        </emission>
                        <ambient>
                            <color>0 0 0 1</color>
                        </ambient>
                        <diffuse>
                            <texture texture="IMG-SAMP" texcoord="" />
                        </diffuse>
                        <specular>
                            <color>0.752941 0.752941 0.752941 1</color>
                        </specular>
                        <shininess>
                            <float>0.6</float>
                        </shininess>
                        <reflective>
                            <color>0 0 0 1</color>
                        </reflective>
                        <reflectivity>
                            <float>1</float>
                        </reflectivity>
                        <transparent>
                            <color>1 1 1 1</color>
                        </transparent>
                        <transparency>
                            <float>1</float>
                        </transparency>
                    </phong>
                </technique>
            </profile_COMMON>
        </effect>
