// WaterHeightBake.compute

#pragma kernel CSMain

#define WATER_SIMULATION
#define WATER_DECAL_COMPLETE
#define WATER_TWO_BANDS
// #define WATER_LOCAL_CURRENT

// HDRP water keywords
// #pragma multi_compile WATER_DECAL_PARTIAL WATER_DECAL_COMPLETE
// #pragma multi_compile WATER_ONE_BAND WATER_TWO_BANDS WATER_THREE_BANDS
// #pragma multi_compile _ WATER_LOCAL_CURRENT

#define WATER_SIMULATION

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.high-definition/Runtime/ShaderLibrary/ShaderVariables.hlsl"
#include "Packages/com.unity.render-pipelines.high-definition/Runtime/Water/Shaders/SampleWaterSurface.hlsl"

// Output texture
RWTexture2D<float4> Result;

// Texture size
int _Resolution;

// World-space area covered by the texture
float2 _WorldCenterXZ;
float _WorldSize;

// Base water level Y
float _BaseWaterY;

// Search settings
#define SEARCH_ITERATION_COUNT 8
#define SEARCH_DISTANCE_THRESHOLD 0.001

[numthreads(8,8,1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution || id.y >= _Resolution)
        return;

    // UV in [0,1]
    float2 uv = (id.xy + 0.5) / _Resolution;

    // Map to world XZ
    float2 worldXZ =
        _WorldCenterXZ +
        (uv - 0.5) * _WorldSize;

    // Query position
    float3 queryPos = float3(
        worldXZ.x,
        _BaseWaterY,
        worldXZ.y
    );

    int stepCount;
    float currentError;

    float displacement = FindVerticalDisplacement(
        queryPos,
        SEARCH_ITERATION_COUNT,
        SEARCH_DISTANCE_THRESHOLD,
        stepCount,
        currentError
    );

    float waterHeight = queryPos.y + displacement;

    // Store:
    // R = normalized height
    // G = error
    // B = iterations
    // A = 1
    Result[id.xy] = float4(
        waterHeight,
        currentError,
        stepCount,
        1.0
    );
}